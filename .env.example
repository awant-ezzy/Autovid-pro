# Prisma SQLite database. Keep the database file on persistent storage.
DATABASE_URL="file:./dev.db"

# n8n production webhook and shared Header Auth secret.
N8N_WEBHOOK_URL="https://n8n.example.com/webhook/autovid-generate"
N8N_WEBHOOK_TOKEN="replace-with-a-long-random-secret"
N8N_TIMEOUT_MS=240000

# Optional Next.js server port.
PORT=3000
